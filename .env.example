# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this Next.js app (no trailing slash). Also the JWT issuer/audience.
BETTER_AUTH_URL=http://localhost:3000

# --- MongoDB (same database as the server) ---
MONGODB_URI=
DB_NAME=wedplan

# --- Google OAuth ---
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Express API ---
NEXT_PUBLIC_API_URL=http://localhost:5000
